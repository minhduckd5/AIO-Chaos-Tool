apiVersion: chaos-mesh.org/v1alpha1
kind: PodChaos
metadata:
  name: {{ experiment_name | lower | replace(" ", "-") }}
  namespace: {{ namespace | default("default") }}
  labels:
    app.kubernetes.io/managed-by: {{ managed_by | default("chaosgen") }}
    chaosgen.io/ephemeral: "{{ ephemeral | default("true") }}"
    chaosgen.io/experiment: {{ experiment_label | default("chaosgen") }}
{% if run_id %}
    chaosgen.io/run-id: "{{ run_id }}"
{% endif %}
spec:
  action: pod-kill
  mode: {{ mode | default("one") }}
  selector:
    namespaces:
      - {{ namespace | default("default") }}
    labelSelectors:
      {{ label_key | default("app") }}: {{ target_name }}
  gracePeriod: {{ grace_period | default(0) }}
  duration: "{{ duration }}"
